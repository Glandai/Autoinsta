# Secrets du studio. Ce fichier reste sur l'ordinateur : ne jamais l'envoyer ni le coller dans une conversation.
# Remplis-le toi-même avec un éditeur de texte. Claude n'a pas besoin de voir ces valeurs.

# --- Instagram, route Facebook (recommandée) : voir docs/connexion-instagram.md
FB_APP_ID=
FB_APP_SECRET=
FB_SHORT_TOKEN=

# Remplis automatiquement par « ./studio jeton echanger » (ou à la main pour la route Instagram)
IG_ACCESS_TOKEN=
IG_USER_ID=
IG_TOKEN_EXPIRES=

# --- Hébergement Supabase (facultatif : seulement si publication.hebergement vaut supabase)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
